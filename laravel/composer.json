{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.0",
        "dotswan/filament-map-picker": "^2.0",
        "filament/filament": "^4.0",
        "laravel/framework": "^12.0",
        "nwidart/laravel-modules": "*",
        "thecodingmachine/safe": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "go": [
            "@php -d memory_limit=-1 composer.phar selfupdate",
            "rm -rf ./app/View/Components/vendor/",
            "rm -rf ./resources/views/vendor/",
            "@php -d memory_limit=-1 composer.phar update -W",
            "@php artisan vendor:publish --all",
            "rm -rf database/migrations/*",
            "rm -rf ./app/View/Components/vendor/",
            "mkdir -p bootstrap/cache",
            "@php artisan migrate",
            "@php artisan filament:upgrade",
            "@php artisan filament:optimize",
            "@php artisan config:cache",
            "@php artisan view:cache",
            "@php artisan icons:cache",
            "@php artisan route:clear",
            "sudo chown -R www-data:www-data ..",
            "sudo chmod -R g+w ..",
            "@php artisan serve"
        ],
        "go-mac": [
            "@php -d memory_limit=-1 composer.phar selfupdate",
            "rm -rf ./app/View/Components/vendor/",
            "rm -rf ./resources/views/vendor/",
            "@php -d memory_limit=-1 composer.phar update -W",
            "@php artisan vendor:publish --all",
            "rm -rf database/migrations/*",
            "rm -rf ./app/View/Components/vendor/",
            "mkdir -p bootstrap/cache",
            "@php artisan migrate",
            "@php artisan filament:upgrade",
            "@php artisan filament:optimize",
            "@php artisan optimize --quiet",
            "@php artisan route:clear",
            "@php artisan serve"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "codewithkyrian/transformers-libsloader": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "filament/upgrade": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.88",
        "larastan/larastan": "^3.7",
        "laravel/boost": "^1.0",
        "laravel/pint": "^1.25",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-arch": "^3.1",
        "pestphp/pest-plugin-drift": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "phploc/phploc": "^2.0",
        "phpmd/phpmd": "*",
        "phpmetrics/phpmetrics": "^2.9",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^6.13"
    }
}
