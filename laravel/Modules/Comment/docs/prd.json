{
  "name": "Comment",
  "type": "module",
  "status": "baseline",
  "purpose": "Gestire commenti e interazioni conversazionali associate ai contenuti del sito.",
  "goals": [
    "Consentire discussione su contenuti e mercati",
    "Supportare moderazione e notifiche",
    "Mantenere relazione coerente con Article/Predict"
  ],
  "nonGoals": [
    "Gestire order flow o settlement"
  ],
  "dependencies": [
    "Notify",
    "User",
    "Xot"
  ],
  "qualityGates": [
    "./vendor/bin/phpstan analyse Modules/Comment",
    "./vendor/bin/phpinsights analyse Modules/Comment --min-quality=0 --min-complexity=0 --min-architecture=0 --min-style=0"
  ],
  "suiteVersion": "baseline-v1",
  "sourceFramework": "Notion product template family adapted to repository governance",
  "companionDocs": [
    "product-roadmap.md",
    "product-launch-plan.md",
    "product-strategy.md",
    "user-research.md",
    "sprint-planning-meeting.md"
  ],
  "implementationPattern": "action-first",
  "actionStandard": "spatie/laravel-queueable-action",
  "architectureRule": "No generic Services for business logic; use Action classes with execute()"
}
