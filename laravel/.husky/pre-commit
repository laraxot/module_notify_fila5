#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run PHPStan on staged files
echo "📊 Running PHPStan..."
./vendor/bin/phpstan analyse --level=3 --error-format=table

if [ $? -ne 0 ]; then
    echo "❌ PHPStan failed. Please fix the errors before committing."
    exit 1
fi

# Run Pint on staged files
echo "🎨 Running Laravel Pint..."
./vendor/bin/pint

if [ $? -ne 0 ]; then
    echo "❌ Code style check failed. Please fix the errors before committing."
    exit 1
fi

# Run tests
echo "🧪 Running tests..."
./vendor/bin/pest --bail

if [ $? -ne 0 ]; then
    echo "❌ Tests failed. Please fix the failing tests before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed!"
